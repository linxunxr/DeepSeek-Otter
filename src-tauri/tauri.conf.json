{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Otter",
  "version": "0.1.0",
  "identifier": "com.linxunxr.deepseek-otter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeepSeek Otter",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/runtime/npm.tgz": "runtime/npm.tgz",
      "resources/runtime/dsh-store": "runtime/dsh-store",
      "../upstream.json": "upstream.json"
    }
  }
}
