{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "壳本地页面（加载页/诊断页/更新）的 IPC 权限；回环 dsh Web UI 不授予任何权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "updater:default",
    "process:allow-restart",
    "process:default"
  ]
}
