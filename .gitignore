# 依赖
node_modules/

# 构建产物
dist/
src-tauri/target/
src-tauri/gen/

# Tauri 自动生成的 sidecar 二进制与运行时资源（构建前由 scripts/fetch-runtime.mjs 下载/生成）
# 注意：git 无法重新包含被忽略目录内的文件，因此 resources 逐项忽略而非整目录忽略。
src-tauri/binaries/
src-tauri/resources/runtime/npm.tgz
src-tauri/resources/runtime/npm-cli-pkg/
src-tauri/resources/runtime/dsh-store.tar.gz
src-tauri/resources/runtime/dsh-store/node_modules/
src-tauri/resources/runtime/dsh-store/.package-lock.json
# dsh-store 的 package.json / package-lock.json 入库（强绑定的版本记录）

# 日志与本地运行数据
*.log
.DS_Store

# IDE
.idea/
.vscode/
